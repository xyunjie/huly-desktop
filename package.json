{
  "name": "huly-desk",
  "private": true,
  "version": "1.1.4",
  "description": "Huly Desk：面向 Huly 工作区的跨平台任务客户端",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_DATA_MODE=mock vite",
